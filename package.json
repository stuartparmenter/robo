{
  "name": "robo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/worker dev",
    "deploy": "bun run --cwd apps/worker deploy",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --cwd apps/worker typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
